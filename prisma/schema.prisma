// Documentación: https://www.prisma.io/docs
//
// La URL de conexión NO vive acá: en Prisma 7 el CLI la lee desde
// prisma.config.ts y el runtime la recibe vía driver adapter (PrismaPg),
// configurado en src/prisma/prisma.service.ts.

generator client {
  provider = "prisma-client"

  // `prisma-client-js` está deprecado. El generador nuevo exige un `output`
  // explícito y genera dentro del proyecto en vez de node_modules.
  // Tiene que caer dentro de src/ porque tsconfig.build.json compila
  // únicamente ese directorio (rootDir: ./src, include: ["src"]).
  output = "../src/generated/prisma"

  // Query compiler en WASM: sin binario nativo de Rust, lo que permite usar
  // imágenes Alpine sin instalar libssl.
  engineType = "client"
  runtime    = "nodejs"

  // El proyecto es ESM puro ("type": "module" + moduleResolution nodenext),
  // así que el cliente se genera como ESM y sus imports relativos llevan la
  // extensión .js que tsc espera al emitir.
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid())
email String @unique
passwordHash String @map("password_hash")
role Role @default(MIEMBRO)
memberNumber String? @unique @map("member_number")
isActive Boolean @default(true) @map("is_active")
createdAt DateTime @default(now()) @map("created_at")
updatedAt DateTime @updatedAt @map("updated_at")
refreshTokens RefreshToken[]
memberships Membership[]
templates ClassTemplate[]
reservations ClassReservation[]
trainerSlots TrainerSlot[]
personalSessionsAsTrainer PersonalSession[] @relation("trainer_sessions")
personalSessionsAsMember PersonalSession[] @relation("member_sessions")
trainerAssignments TrainerMemberAssignment[] @relation("trainer_assignments
memberAssignments TrainerMemberAssignment[] @relation("member_assignments")
routinesAsTrainer TrainingRoutine[] @relation("routine_trainers")
routinesAsMember TrainingRoutine[] @relation("routine_members")
machinesCreated MachineMaintenance[] @relation("maintenance_creator")
machinesClosed MachineMaintenance[] @relation("maintenance_closer")

@@map("users")

}

model RefreshToken {
  id String @id @default(uuid())
   // Se guarda el SHA-256 del token, nunca el token en claro: si se filtra la
  // base, los refresh tokens emitidos no son utilizables.
tokenHash String @unique @map("token_hash")
userId String @map("user_id")
user User @relation(fields: [userId], references: [id], onDelete: Cascade)
expiresAt DateTime @map("expires_at")
revokedAt DateTime? @map("revoked_at")
createdAt DateTime @default(now()) @map("created_at")
@@index([userId])
@@map("refresh_tokens")
}
