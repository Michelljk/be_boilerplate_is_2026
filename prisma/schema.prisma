  userId   String  @unique @map("user_id") @db.Uuid
  fullName String  @map("full_name") @db.VarChar(100)
  phone    String? @db.VarChar(20)
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model User {
  id                        String                    @id @default(uuid()) @db.Uuid
  email                     String                    @unique
  passwordHash              String                    @map("password_hash")
  isActive                  Boolean                   @default(true) @map("is_active")
  createdAt                 DateTime                  @default(now()) @map("created_at")
  updatedAt                 DateTime                  @updatedAt @map("updated_at")
  role                      UserRole                  @default(MIEMBRO)
  checkIns                  CheckIn[]                 @relation("check_ins_member_idTousers")
  registeredCheckIns        CheckIn[]                 @relation("check_ins_registered_by_idTousers")
  updatedAttendances        ClassReservation[]        @relation("class_reservations_attendance_updated_by_idTousers")
  cancelledReservations     ClassReservation[]        @relation("class_reservations_cancelled_by_idTousers")
  reservations              ClassReservation[]        @relation("class_reservations_member_idTousers")
  cancelledSessions         ClassSession[]            @relation("class_sessions_cancelled_by_idTousers")
  completedSessions         ClassSession[]            @relation("class_sessions_completed_by_idTousers")
  sessions                  ClassSession[]            @relation("class_sessions_trainer_idTousers")
  templates                 ClassTemplate[]
  machinesClosed            MachineMaintenance[]      @relation("machine_maintenances_closed_by_idTousers")
  machinesCreated           MachineMaintenance[]      @relation("machine_maintenances_created_by_idTousers")
  machineStatusChanges      MachineStatusChange[]
  memberProfile             MemberProfile?
  createdMembershipRequests MembershipRequest[]       @relation("membership_requests_created_by_idTousers")
  membershipRequests        MembershipRequest[]       @relation("membership_requests_member_idTousers")
  memberships               Membership[]
  notifications             Notification[]
  payments                  Payment[]                 @relation("payments_member_idTousers")
  registeredPayments        Payment[]                 @relation("payments_registered_by_idTousers")
  voidedPayments            Payment[]                 @relation("payments_voided_by_idTousers")
  cancelledPersonalSessions PersonalSession[]         @relation("personal_sessions_cancelled_by_idTousers")
  markedPersonalSessions    PersonalSession[]         @relation("personal_sessions_marked_by_idTousers")
  personalSessionsAsMember  PersonalSession[]         @relation("personal_sessions_member_idTousers")
  personalSessionsAsTrainer PersonalSession[]         @relation("personal_sessions_trainer_idTousers")
  progressRecords           ProgressRecord[]
  refreshTokens             RefreshToken[]
  reviews                   Review[]
  memberAssignments         TrainerMemberAssignment?  @relation("trainer_member_assignments_member_idTousers")
  trainerAssignments        TrainerMemberAssignment[] @relation("trainer_member_assignments_trainer_idTousers")
  trainerSlots              TrainerSlot[]
  memberRoutines            TrainingRoutine?          @relation("training_routines_member_idTousers")
  trainerRoutines           TrainingRoutine[]         @relation("training_routines_trainer_idTousers")
  profile                   UserProfile?

  @@map("users")
}

