generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  previewFeatures        = ["partialIndexes"]
  engineType             = "client"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
  moduleFormat           = "esm"
  runtime                = "nodejs"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model CheckIn {
  id               String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId         String                  @map("member_id") @db.Uuid
  checkedInAt      DateTime                @map("checked_in_at")
  checkInDate      DateTime                @map("check_in_date") @db.Date
  membershipStatus CheckInMembershipStatus @map("membership_status")
  expiredConfirmed Boolean                 @default(false) @map("expired_confirmed")
  registeredById   String                  @map("registered_by_id") @db.Uuid
  createdAt        DateTime                @default(now()) @map("created_at")
  member           User                    @relation("check_ins_member_idTousers", fields: [memberId], references: [id])
  registeredBy     User                    @relation("check_ins_registered_by_idTousers", fields: [registeredById], references: [id])

  @@unique([memberId, checkInDate])
  @@index([checkInDate])
  @@index([checkedInAt(sort: Desc)])
  @@map("check_ins")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ClassReservation {
  id                    String            @id @default(uuid()) @db.Uuid
  sessionId             String            @map("session_id") @db.Uuid
  memberId              String            @map("member_id") @db.Uuid
  membershipId          String?           @map("membership_id") @db.Uuid
  creditConsumed        Boolean           @default(false) @map("credit_consumed")
  creditRefunded        Boolean           @default(false) @map("credit_refunded")
  status                ReservationStatus @default(CONFIRMADA)
  attendance            AttendanceStatus  @default(PENDIENTE)
  cancelledAt           DateTime?         @map("cancelled_at")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")
  cancelledById         String?           @map("cancelled_by_id") @db.Uuid
  attendanceUpdatedAt   DateTime?         @map("attendance_updated_at")
  attendanceUpdatedById String?           @map("attendance_updated_by_id") @db.Uuid
  attendanceUpdatedBy   User?             @relation("class_reservations_attendance_updated_by_idTousers", fields: [attendanceUpdatedById], references: [id])
  cancelledBy           User?             @relation("class_reservations_cancelled_by_idTousers", fields: [cancelledById], references: [id])
  member                User              @relation("class_reservations_member_idTousers", fields: [memberId], references: [id])
  membership            Membership?       @relation(fields: [membershipId], references: [id])
  session               ClassSession      @relation(fields: [sessionId], references: [id])

  @@unique([sessionId, memberId])
  @@index([memberId, status])
  @@index([sessionId, status])
  @@map("class_reservations")
}

